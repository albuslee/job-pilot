# LLM — LiteLLM gateway (OpenAI-compatible)
LITELLM_BASE_URL=http://localhost:4000/v1
LITELLM_API_KEY=your-bearer-token
LLM_MODEL=claude-sonnet-4-6

# Embedding provider: "ollama" (default) | "voyage" | "openai"
EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Voyage (optional — free tier available)
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3

# OpenAI (optional)
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Paths
PROFILE_DIR=data/profile
CHROMA_DIR=.chroma
OUTPUT_DIR=output
CV_TEMPLATE_PATH=data/cv_template.docx
BULLET_POOL_PATH=data/bullet_pool.yaml

# Personal identity — used only to compose output filenames + locate your
# current-role section in your CV template. Both are local; never logged
# remotely.
OWNER_NAME=Your Full Name
# The exact text in your CV that identifies your current role (used by the
# tailor's docx_writer to find the bullet block to rewrite). Empty = skip
# role-bullet replacement; only summary + skills get rewritten.
CURRENT_ROLE_ANCHOR=

# Behaviour
SCORE_THRESHOLD=70
RETRIEVAL_K=8
SMART_DOCX_INGEST=false
LOG_FORMAT=console
