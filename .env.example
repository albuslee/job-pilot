# Required
ANTHROPIC_API_KEY=sk-ant-...

# Embedding provider: "voyage" (default) or "openai"
EMBEDDING_PROVIDER=voyage
VOYAGE_API_KEY=
OPENAI_API_KEY=

# Models
ANTHROPIC_MODEL=claude-sonnet-4-6
VOYAGE_MODEL=voyage-3
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Paths
PROFILE_DIR=data/profile
CHROMA_DIR=.chroma
OUTPUT_DIR=output

# Behaviour
SCORE_THRESHOLD=70
RETRIEVAL_K=8
LOG_FORMAT=console
